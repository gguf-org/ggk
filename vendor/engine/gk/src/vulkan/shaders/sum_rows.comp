#version 450
#extension GL_GOOGLE_include_directive : require

#include "gk_common.glsl"

// i[0] = 1 for mean, 0 for sum_rows.

layout(local_size_x = 256) in;

layout(binding = 1, std430) readonly buffer S0 { uint s0[]; };
layout(binding = 4, std430) buffer D { uint d[]; };

GK_QUANT_READER(a, s0)
GK_WRITER(o, d)
GK_REDUCTION(256u)

void main() {
    const uint ir  = gl_WorkGroupID.x;
    const uint tid = gl_LocalInvocationID.x;

    const uint i1 = ir % P.dst.ne.y;
    const uint i2 = (ir / P.dst.ne.y) % P.dst.ne.z;
    const uint i3 = ir / (P.dst.ne.y * P.dst.ne.z);

    float local = 0.0;
    for (uint i = tid; i < P.src0.ne.x; i += 256u) {
        local += a_getq(P.src0, i, i1, i2, i3);
    }

    const float total = gk_block_sum(local, tid);

    if (tid == 0u) {
        o_set(P.dst, 0u, i1, i2, i3, P.i0[0] != 0 ? total / float(P.src0.ne.x) : total);
    }
}
