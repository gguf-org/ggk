#version 450
#extension GL_GOOGLE_include_directive : require

#include "gk_common.glsl"

// One thread per rotated pair. The angle depends only on the position and the
// pair index, so it is recomputed per thread rather than cached per token: two
// transcendentals are cheaper than the shared memory and the barrier a cache
// would need, and it keeps every pair independent.
//
// i[0] = n_dims, i[1] = mode, i[2..5] = sections;
// f[0] = freq_scale, f[1] = ext_factor, f[2] = attn_factor, f[3] = theta_scale,
// f[4..5] = the YaRN correction band; flags bit 0 = frequency factors bound.

layout(local_size_x = 256) in;

layout(binding = 1, std430) readonly buffer S0 { uint s0[]; };
layout(binding = 2, std430) readonly buffer S1 { uint s1[]; };
layout(binding = 3, std430) readonly buffer S2 { uint s2[]; };
layout(binding = 4, std430) buffer D { uint d[]; };

GK_QUANT_READER(a, s0)
GK_WRITER(o, d)

void main() {
    const uint k = gl_GlobalInvocationID.x;
    if (k >= P.n) {
        return;
    }

    const int  n_dims = P.i0[0];
    const int  mode   = P.i0[1];
    const bool neox   = (mode & 2) != 0;
    const bool mrope  = (mode & 8) != 0;
    const bool vision = mode == 24;
    const bool imrope = mode == 40;

    const uint n_rot = vision ? P.dst.ne.x : uint(n_dims);
    const uint pairs_per_row = n_rot / 2u;

    const uint ir = k / pairs_per_row;
    const uint ip = k % pairs_per_row;

    const uint i1 = ir % P.dst.ne.y;
    const uint i2 = (ir / P.dst.ne.y) % P.dst.ne.z;
    const uint i3 = ir / (P.dst.ne.y * P.dst.ne.z);

    const uint i0 = ip * 2u;

    // three pairings share the rotation: normal pairs (2i, 2i+1), neox and the
    // multi-axis ropes pair (i, i + n_dims/2), and the vision rope pairs
    // (i, i + n_dims) across the full width
    float theta_base;
    if (!mrope) {
        const uint poff = P.src1.base + i2 * P.src1.nb.x;
        theta_base = float(int(s1[poff >> 2])) * pow(P.f01[3], float(ip));
    } else {
        const uint n_pos = P.dst.ne.z;
        const int sect_dims = P.i0[2] + P.i0[3] + P.i1[0] + P.i1[1];
        const int sec_w = P.i0[3] + P.i0[2];
        const int sec_e = P.i1[0] + sec_w;

        const int sector = int(ip % uint(sect_dims));

        int axis;
        if (imrope) {
            if (sector % 3 == 1 && sector < 3 * P.i0[3])      { axis = 1; }
            else if (sector % 3 == 2 && sector < 3 * P.i1[0]) { axis = 2; }
            else if (sector % 3 == 0 && sector < 3 * P.i0[2]) { axis = 0; }
            else                                              { axis = 3; }
        } else {
            if (sector < P.i0[2])              { axis = 0; }
            else if (sector < sec_w)           { axis = 1; }
            else if (sector < sec_w + P.i1[0]) { axis = 2; }
            else                               { axis = 3; }
        }

        int step = int(ip);
        if (vision) {
            // the vision rope restarts each axis's angle at its section
            const int base = axis == 0 ? 0 : axis == 1 ? P.i0[2] : axis == 2 ? sec_w : sec_e;
            step = int(ip) - base;
        }

        const uint poff = P.src1.base + (i2 + n_pos * uint(axis)) * P.src1.nb.x;
        theta_base = float(int(s1[poff >> 2])) * pow(P.f01[3], float(step));
    }

    if ((P.flags & 1u) != 0u) {
        theta_base /= uintBitsToFloat(s2[(P.src2.base + ip * 4u) >> 2]);
    }

    float theta  = theta_base * P.f01[0];
    float mscale = P.f01[2];

    if (P.f01[1] != 0.0) {
        // YaRN: blend the scaled and unscaled angles across the correction
        // band, and compensate the entropy a stretched context adds
        const float y = (float(i0 / 2u) - P.f23[0]) / max(0.001, P.f23[1] - P.f23[0]);
        const float ramp = (1.0 - clamp(y, 0.0, 1.0)) * P.f01[1];

        theta = theta * (1.0 - ramp) + theta_base * ramp;
        mscale *= 1.0 + 0.1 * log(1.0 / P.f01[0]);
    }

    const float cos_t = cos(theta) * mscale;
    const float sin_t = sin(theta) * mscale;

    const uint offset = vision ? uint(n_dims) : ((neox || mrope) ? uint(n_dims) / 2u : 1u);
    const uint ic     = (neox || mrope) ? ip : i0;

    const float x0 = a_getq(P.src0, ic,          i1, i2, i3);
    const float x1 = a_getq(P.src0, ic + offset, i1, i2, i3);

    o_set(P.dst, ic,          i1, i2, i3, x0 * cos_t - x1 * sin_t);
    o_set(P.dst, ic + offset, i1, i2, i3, x0 * sin_t + x1 * cos_t);
}
