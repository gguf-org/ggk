#version 450
#extension GL_GOOGLE_include_directive : require

#include "gk_common.glsl"

// f[0] = scale, f[1] = max_bias, i[0] = n_head_log2,
// flags bit 0 = a mask is bound, bit 1 = sinks are bound.

layout(local_size_x = 256) in;

layout(binding = 1, std430) readonly buffer S0 { uint s0[]; };
layout(binding = 2, std430) readonly buffer S1 { uint s1[]; };
layout(binding = 3, std430) readonly buffer S2 { uint s2[]; };
layout(binding = 4, std430) buffer D { uint d[]; };

GK_QUANT_READER(a, s0)
GK_FLOAT_READER(m, s1)
GK_FLOAT_READER(k, s2)
GK_WRITER(o, d)
GK_REDUCTION(256u)

void main() {
    const uint ir  = gl_WorkGroupID.x;
    const uint tid = gl_LocalInvocationID.x;

    const uint i1 = ir % P.dst.ne.y;
    const uint i2 = (ir / P.dst.ne.y) % P.dst.ne.z;
    const uint i3 = ir / (P.dst.ne.y * P.dst.ne.z);

    const uint n = P.dst.ne.x;

    const bool has_mask  = (P.flags & 1u) != 0u;
    const bool has_sinks = (P.flags & 2u) != 0u;

    const float scale    = P.f01[0];
    const float max_bias = P.f01[1];

    // the ALiBi slope for this head: the first power-of-two heads step down
    // geometrically and any beyond interleave a second sequence
    float slope = 1.0;
    if (max_bias > 0.0) {
        const float n_head_log2 = float(P.i0[0]);
        const float m0 = pow(2.0, -max_bias / n_head_log2);
        const float m1 = pow(2.0, -(max_bias / 2.0) / n_head_log2);
        slope = float(i2) < n_head_log2
            ? pow(m0, float(i2) + 1.0)
            : pow(m1, 2.0 * (float(i2) - n_head_log2) + 1.0);
    }

    float local_max = -1.0 / 0.0;
    for (uint i = tid; i < n; i += 256u) {
        float v = a_getq(P.src0, i, i1, i2, i3) * scale;
        if (has_mask) {
            v += slope * m_get(P.src1, i, i1, i2 % P.src1.ne.z, i3 % P.src1.ne.w);
        }
        local_max = max(local_max, v);
    }

    float row_max = gk_block_max(local_max, tid);

    const float sink = has_sinks ? k_get(P.src2, i2, 0u, 0u, 0u) : -1.0 / 0.0;
    if (has_sinks) {
        row_max = max(row_max, sink);
    }

    // a fully masked row is all -inf; define it as a uniform zero row rather
    // than the 0/0 that exponentiating would give
    if (isinf(row_max) || isnan(row_max)) {
        for (uint i = tid; i < n; i += 256u) {
            o_set(P.dst, i, i1, i2, i3, 0.0);
        }
        return;
    }

    float local_sum = 0.0;
    for (uint i = tid; i < n; i += 256u) {
        float v = a_getq(P.src0, i, i1, i2, i3) * scale;
        if (has_mask) {
            v += slope * m_get(P.src1, i, i1, i2 % P.src1.ne.z, i3 % P.src1.ne.w);
        }
        const float e = exp(v - row_max);
        o_set(P.dst, i, i1, i2, i3, e);
        local_sum += e;
    }

    float sum = gk_block_sum(local_sum, tid);
    if (has_sinks) {
        sum += exp(sink - row_max);
    }

    const float inv = 1.0 / sum;
    for (uint i = tid; i < n; i += 256u) {
        o_set(P.dst, i, i1, i2, i3, o_read(P.dst, i, i1, i2, i3) * inv);
    }
}
