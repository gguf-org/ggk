#version 450
#extension GL_GOOGLE_include_directive : require

#include "gk_common.glsl"

// Mixture of experts: `ids` holds, per token, which experts it routes to, and
// every (token, slot) pair picks one expert's rows out of src0.

layout(local_size_x = 256) in;

layout(binding = 1, std430) readonly buffer S0 { uint s0[]; };
layout(binding = 2, std430) readonly buffer S1 { uint s1[]; };
layout(binding = 3, std430) readonly buffer S2 { uint s2[]; };
layout(binding = 4, std430) buffer D { uint d[]; };

GK_QUANT_READER(a, s0)
GK_FLOAT_READER(b, s1)
GK_WRITER(o, d)
GK_REDUCTION(256u)

void main() {
    const uint tid = gl_LocalInvocationID.x;

    const uint i0 = gl_WorkGroupID.x; // row within the expert
    const uint is = gl_WorkGroupID.y; // which of the token's expert slots
    const uint it = gl_WorkGroupID.z; // which token

    const uint off = P.src2.base + it * P.src2.nb.y + is * P.src2.nb.x;
    const uint expert = uint(int(s2[off >> 2]));

    float acc = 0.0;
    for (uint kk = tid; kk < P.src0.ne.x; kk += 256u) {
        acc += a_getq(P.src0, kk, i0, expert, 0u) * b_get(P.src1, kk, 0u, it, 0u);
    }

    const float total = gk_block_sum(acc, tid);

    if (tid == 0u) {
        o_set(P.dst, i0, is, it, 0u, total);
    }
}
