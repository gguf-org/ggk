#version 450
#extension GL_GOOGLE_include_directive : require

#include "gk_common.glsl"

// dst[i0,i1,i2,i3] = dot( a_row(i0, i2/r2, i3/r3), b_row(i1,i2,i3) )
//
// One workgroup per output element, or per group of i[0] of them along the
// activation columns: the weight element is decoded once and multiplied into
// every column of the group, which is the reuse that keeps a quantized matmul
// bound by memory rather than by decoding.
//
// The higher dimensions of the weight broadcast onto the activations':
// grouped-query attention has fewer key heads than query heads and each key
// head serves a group.

layout(local_size_x = 256) in;

layout(binding = 1, std430) readonly buffer S0 { uint s0[]; };
layout(binding = 2, std430) readonly buffer S1 { uint s1[]; };
layout(binding = 4, std430) buffer D { uint d[]; };

GK_QUANT_READER(a, s0)
GK_FLOAT_READER(b, s1)
GK_WRITER(o, d)
GK_REDUCTION(256u)

#define GK_MM_NC 4

void main() {
    const uint tid = gl_LocalInvocationID.x;

    const uint i0  = gl_WorkGroupID.x;
    const uint c0  = gl_WorkGroupID.y * uint(P.i0[0]);
    const uint i23 = gl_WorkGroupID.z;

    const uint i2 = i23 % P.dst.ne.z;
    const uint i3 = i23 / P.dst.ne.z;

    const uint r2 = P.src1.ne.z / P.src0.ne.z;
    const uint r3 = P.src1.ne.w / P.src0.ne.w;

    const uint a2 = i2 / r2;
    const uint a3 = i3 / r3;

    const uint k_len = P.src0.ne.x;

    float acc[GK_MM_NC] = float[GK_MM_NC](0.0, 0.0, 0.0, 0.0);

    for (uint kk = tid; kk < k_len; kk += 256u) {
        const float av = a_getq(P.src0, kk, i0, a2, a3);

        for (int j = 0; j < P.i0[0]; ++j) {
            const uint col = c0 + uint(j);
            if (col < P.dst.ne.y) {
                acc[j] += av * b_get(P.src1, kk, col, i2, i3);
            }
        }
    }

    for (int j = 0; j < P.i0[0]; ++j) {
        const float total = gk_block_sum(acc[j], tid);

        const uint col = c0 + uint(j);
        if (tid == 0u && col < P.dst.ne.y) {
            o_set(P.dst, i0, col, i2, i3, total);
        }
    }
}
