#version 450
#extension GL_GOOGLE_include_directive : require

#include "gk_common.glsl"

layout(local_size_x = 256) in;

layout(binding = 1, std430) readonly buffer S0 { uint s0[]; };
layout(binding = 2, std430) readonly buffer S1 { uint s1[]; };
layout(binding = 3, std430) readonly buffer S2 { uint s2[]; };
layout(binding = 4, std430) buffer D { uint d[]; };

GK_QUANT_READER(a, s0)
GK_FLOAT_READER(b, s1)
GK_FLOAT_READER(c, s2)
GK_WRITER(o, d)

void main() {
    const uint k = gl_GlobalInvocationID.x;
    if (k >= P.n) {
        return;
    }

    const uvec4 x = gk_decompose(k, P.dst);

    // one operand: the row splits in half and i[1] says which half is
    // activated. Two operands: src0 is activated, src1 multiplies.
    const uint half_w = P.dst.ne.x;

    float act, mul;
    if (P.flags != 0u) {
        act = a_getq(P.src0, x.x, x.y, x.z, x.w);
        mul = b_get (P.src1, x.x, x.y, x.z, x.w);
    } else {
        const uint ia = P.i0[1] != 0 ? x.x + half_w : x.x;
        const uint im = P.i0[1] != 0 ? x.x          : x.x + half_w;
        act = a_getq(P.src0, ia, x.y, x.z, x.w);
        mul = a_getq(P.src0, im, x.y, x.z, x.w);
    }

    float r;
    switch (P.i0[0]) {
        case 0:  r = max(act, 0.0) * mul;      break;
        case 1:  r = gk_gelu(act) * mul;       break;
        case 2:  r = gk_silu(act) * mul;       break;
        case 4:  r = gk_gelu_erf(act) * mul;   break;
        case 5:  r = gk_gelu_quick(act) * mul; break;
        default: {
            const float alpha = P.f01[0];
            const float limit = P.f01[1];
            const float xv = min(act, limit);
            const float yv = clamp(mul, -limit, limit);
            const float g  = xv / (1.0 + exp(alpha * (-xv)));
            r = g * (yv + 1.0);
            break;
        }
    }

    o_set(P.dst, x.x, x.y, x.z, x.w, r);
}
