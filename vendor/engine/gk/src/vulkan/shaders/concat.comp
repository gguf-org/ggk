#version 450
#extension GL_GOOGLE_include_directive : require

#include "gk_common.glsl"

layout(local_size_x = 256) in;

layout(binding = 1, std430) readonly buffer S0 { uint s0[]; };
layout(binding = 2, std430) readonly buffer S1 { uint s1[]; };
layout(binding = 3, std430) readonly buffer S2 { uint s2[]; };
layout(binding = 4, std430) buffer D { uint d[]; };

GK_QUANT_READER(a, s0)
GK_FLOAT_READER(b, s1)
GK_FLOAT_READER(c, s2)
GK_WRITER(o, d)

void main() {
    const uint k = gl_GlobalInvocationID.x;
    if (k >= P.n) {
        return;
    }

    const uvec4 x = gk_decompose(k, P.dst);

    uvec4 j = x;
    bool second;

    switch (P.i0[0]) {
        case 0: second = x.x >= P.src0.ne.x; if (second) { j.x -= P.src0.ne.x; } break;
        case 1: second = x.y >= P.src0.ne.y; if (second) { j.y -= P.src0.ne.y; } break;
        case 2: second = x.z >= P.src0.ne.z; if (second) { j.z -= P.src0.ne.z; } break;
        default:second = x.w >= P.src0.ne.w; if (second) { j.w -= P.src0.ne.w; } break;
    }

    const float v = second ? b_get(P.src1, j.x, j.y, j.z, j.w)
                           : a_getq(P.src0, j.x, j.y, j.z, j.w);

    o_set(P.dst, x.x, x.y, x.z, x.w, v);
}
